{
  "name": "labelbridge",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @labelbridge/api\" \"npm run dev -w @labelbridge/web\"",
    "build": "npm run build -w @labelbridge/contracts && npm run build -w @labelbridge/web && npm run build -w @labelbridge/api",
    "start": "node apps/api/dist/server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p packages/contracts --noEmit && tsc -p apps/api --noEmit && tsc -p apps/web --noEmit",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run validate:fixtures && npm test && npm run build",
    "smoke": "playwright test",
    "commit:verified": "node scripts/commit-verified.mjs",
    "verify:sha": "node scripts/verify-sha.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "type": "module"
}
