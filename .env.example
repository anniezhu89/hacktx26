# Server configuration. Never put secrets in the web bundle.
PORT=3001

# Image extraction adapter (Google Gemini). Without GEMINI_API_KEY the demo
# stays in fixture mode and uploaded images are left explicitly unresolved.
# Image input was verified on gemini-3.5-flash, gemini-3.6-flash,
# gemini-3-flash-preview and gemini-3.1-flash-lite, but only the two models
# below answered reliably for this account; the others returned 429/503. Model
# availability varies by account, so re-check before relying on another one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried once if the model above is transiently unavailable (429/503), which the
# flash models do return intermittently. Set to empty to disable the fallback.
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# Text generation. NOT usable for image extraction: a 2026-10-24 capability
# spike showed this endpoint accepts an image part, returns HTTP 200, and
# silently ignores the image (15 -> 20 input tokens, and a wrong answer about
# image content). Do not route extraction here. See docs/verification.md.
META_API_KEY=
META_ENDPOINT=
META_MODEL=

# Pharmacy lookup via the SerpApi Google Maps engine (backend only; never
# called from the browser). Verified on the Free Plan in a 2026-10-24 spike:
# engine=google_maps with a ZIP or city in the query needs no coordinates, so
# only a coarse, nonidentifying location is ever sent. Savings search still
# uses this key for nothing: that route remains unimplemented.
#
# The engine answers an unusable location with HTTP 200, status "Success" and
# pharmacies in unrelated states, so the adapter verifies that results are
# clustered near the requested place before showing any. See
# docs/verification.md.
SERPAPI_API_KEY=
# Override only for tests or a proxy; defaults to https://serpapi.com/search.
SERPAPI_ENDPOINT=
# v1.6. Comma-separated demo-account emails the operator approves as volunteer
# readers. Choosing "volunteer" in the app only requests approval.
LABELBRIDGE_APPROVED_VOLUNTEERS=
# NLM reference lookups (RxNorm, DailyMed, MedlinePlus Connect; no key needed).
# Set to 0 to turn the medicine translator off.
LABELBRIDGE_REFERENCE_LOOKUPS=1
# AI summaries/translations of DailyMed labeling text. Off by default: that
# text is manufacturer-supplied and its reuse rights are not guaranteed.
# Set to 1 only after confirming reuse is permitted. Requires GEMINI_API_KEY.
LABELBRIDGE_ALLOW_LABELING_DERIVATIVES=0

# Optional Community Resource Board (server only; off by default)
COMMUNITY_BOARD_ENABLED=0
COMMUNITY_DATA_MODE=fixture
# Live mode reuses SERPAPI_API_KEY and META_API_KEY above. No VITE_ secrets.
# META_MODEL=muse-spark-1.3
OPENCAGE_API_KEY=
COMMUNITY_MAX_QUERIES=3
COMMUNITY_MAX_DETAILS=5
COMMUNITY_CONCURRENCY=2
COMMUNITY_CACHE_MINUTES=60
COMMUNITY_COOLDOWN_SECONDS=60
COMMUNITY_TIMEOUT_MS=45000
